+bool ir_may_fuse_tls_addr(ir_ctx *ctx, ir_ref ref)
+{
+	ir_use_list *use_list = &ctx->use_lists[ref];
+	ir_ref n, *p;
+
+	if (use_list->count == 2 || (ctx->rules[ref] & IR_FUSED)) {
+		return 1;
