+#ifndef ZEND_WIN32
+/* An absolute path without dot segments doesn't need a per-thread CWD emulation */
+static zend_always_inline bool virtual_path_is_direct(const char *path)
+{
+	const char *s = path;
+
+	if (*s != '/') {
+		return false;
+	}
+	do {
+		if (s[1] == '.'
+		 && (s[2] == '\0' || s[2] == '/'
+		  || (s[2] == '.' && (s[3] == '\0' || s[3] == '/')))) {
+			return false;
+		}
+		s = strchr(s + 1, '/');
+	} while (s != NULL);
+	return true;
+}
+#endif
