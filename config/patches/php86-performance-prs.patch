+ZEND_API void zend_win_tsrm_cache_shutdown(void)
+{
+	zend_win_tsrm_cache_offset = 0;
+	if (zend_win_tsrm_cache_slot != TLS_OUT_OF_INDEXES) {
+		TlsFree(zend_win_tsrm_cache_slot);
+		zend_win_tsrm_cache_slot = TLS_OUT_OF_INDEXES;
+	}
